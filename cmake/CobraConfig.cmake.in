@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# cobra-core links absl::flat_hash_map (PUBLIC) and hwy::hwy (PRIVATE)
find_dependency(absl REQUIRED)
find_dependency(hwy REQUIRED CONFIG)

if(@COBRA_HAS_LLVM_TARGET@)
    if(NOT CMAKE_C_COMPILER_LOADED)
        enable_language(C)
    endif()
    find_dependency(LLVM REQUIRED CONFIG)
endif()

# cobra-verify links z3::libz3; consumers need the target available.
if(@Z3_FOUND@)
    if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/../z3/Z3Config.cmake")
        # Forwarding config from superbuild
        include("${CMAKE_CURRENT_LIST_DIR}/../z3/Z3Config.cmake")
    elseif(NOT TARGET z3::libz3)
        find_dependency(Z3 CONFIG)
    endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/CobraTargets.cmake")

if(@COBRA_HAS_LLVM_TARGET@ AND TARGET cobra::cobra-llvm)
    set_property(TARGET cobra::cobra-llvm APPEND PROPERTY
        INTERFACE_INCLUDE_DIRECTORIES "${LLVM_INCLUDE_DIRS}"
    )
endif()

check_required_components(cobra)
