@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# cobra-core links absl::flat_hash_map (PUBLIC) and hwy::hwy (PRIVATE)
find_dependency(absl REQUIRED)
find_dependency(hwy REQUIRED CONFIG)

if(@COBRA_HAS_LLVM_TARGET@)
    if(NOT CMAKE_C_COMPILER_LOADED)
        enable_language(C)
    endif()
    find_dependency(LLVM REQUIRED CONFIG)
endif()

# cobra-verify links whichever solver it was built against; consumers need
# that target available.
if("@COBRA_VERIFY_BACKEND@" STREQUAL "Bitwuzla")
    if(NOT TARGET PkgConfig::BITWUZLA)
        find_dependency(PkgConfig REQUIRED)
        set(PKG_CONFIG_USE_CMAKE_PREFIX_PATH TRUE)
        # Prefer the copy installed next to this config, so a consumer links the
        # same solver cobra-verify was compiled against.
        get_filename_component(_cobra_prefix "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
        if(EXISTS "${_cobra_prefix}/lib/pkgconfig/bitwuzla.pc")
            set(ENV{PKG_CONFIG_PATH} "${_cobra_prefix}/lib/pkgconfig:$ENV{PKG_CONFIG_PATH}")
        endif()
        unset(_cobra_prefix)
        pkg_check_modules(BITWUZLA REQUIRED IMPORTED_TARGET bitwuzla)
    endif()
elseif("@COBRA_VERIFY_BACKEND@" STREQUAL "Z3")
    if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/../z3/Z3Config.cmake")
        # Forwarding config from superbuild
        include("${CMAKE_CURRENT_LIST_DIR}/../z3/Z3Config.cmake")
    elseif(NOT TARGET z3::libz3)
        find_dependency(Z3 CONFIG)
    endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/CobraTargets.cmake")

if(@COBRA_HAS_LLVM_TARGET@ AND TARGET cobra::cobra-llvm)
    set_property(TARGET cobra::cobra-llvm APPEND PROPERTY
        INTERFACE_INCLUDE_DIRECTORIES "${LLVM_INCLUDE_DIRS}"
    )
endif()

check_required_components(cobra)
